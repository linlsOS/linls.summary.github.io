 .../apps/WifiDisplay/jni/UibcMessage.cpp      | 27 ++++++++
 .../WifiDisplay/jni/UibcServerHandler.cpp     | 67 ++++++++++++++-----
 2 files changed, 78 insertions(+), 16 deletions(-)

diff --git a/vendor/rockchip/common/apps/WifiDisplay/jni/UibcMessage.cpp b/vendor/rockchip/common/apps/WifiDisplay/jni/UibcMessage.cpp
index e50d65f05b..39c8718bb1 100644
--- a/vendor/rockchip/common/apps/WifiDisplay/jni/UibcMessage.cpp
+++ b/vendor/rockchip/common/apps/WifiDisplay/jni/UibcMessage.cpp
@@ -555,6 +555,33 @@ void UibcMessage::getScreenResolution(int* x, int* y) {
     sp<IBinder> display(SurfaceComposerClient::getBuiltInDisplay(
             ISurfaceComposer::eDisplayIdMain));
 #endif
+
+#if (PLATFORM_VERSION >= 12)
+    CHECK(display != nullptr);
+    ui::DisplayMode mode;
+    CHECK_EQ(SurfaceComposerClient::getActiveDisplayMode(display, &mode), NO_ERROR);
+    const ui::Size& resolution = mode.resolution;
+    *x = resolution.getWidth();
+    *y = resolution.getHeight();
+    //ALOGD("display is %zd x %zd\n", *x, *y);
+#elif (PLATFORM_VERSION == 11)
+    DisplayConfig config;
+    CHECK_EQ(SurfaceComposerClient::getActiveDisplayConfig(display, &config), NO_ERROR);
+    const ui::Size& resolution = config.resolution;
+    *x = resolution.getWidth();
+    *y displayHeight = resolution.getHeight();
+#else
+    DisplayInfo info;
+    SurfaceComposerClient::getDisplayInfo(display, &info);
+    if(info.w > info.h)
+    {
+         *x = (int32_t)info.w;
+         *y = (int32_t)info.h;
+    } else {
+         *x = (int32_t)info.h;
+         *y = (int32_t)info.w;
+    }   
+#endif
 /*    DisplayInfo info;
     SurfaceComposerClient::getDisplayInfo(display, &info);
     *x = info.w;
diff --git a/vendor/rockchip/common/apps/WifiDisplay/jni/UibcServerHandler.cpp b/vendor/rockchip/common/apps/WifiDisplay/jni/UibcServerHandler.cpp

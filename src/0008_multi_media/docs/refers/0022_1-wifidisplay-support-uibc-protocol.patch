+    m_wfdWidth = width;
+    m_wfdHeight = heigh;
+
+    if ((screenMode == 1) && (m_localHeight > m_localWidth)) {
+        // Landscape
+        temp = m_localWidth;
+        m_localWidth = m_localHeight;
+        m_localHeight = temp;
+    } else if ((screenMode == 0) && (m_wfdHeight < m_wfdWidth)) {
+        // Protrait
+        temp = m_wfdWidth;
+        m_wfdWidth = m_wfdHeight;
+        m_wfdHeight = temp;
+    }

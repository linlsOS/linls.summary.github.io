+
+status_t sendUibcEvent(const char *pEventDes) {
+    //const char* pEventDes = eventDesc.string();
+    int type = *pEventDes;
+
+    ALOGD("[%s][%d]: eventDesc=%s", __FUNCTION__,__LINE__,pEventDes);
+
+    if (*(pEventDes+1) != ',')
+        return BAD_VALUE;
+
+    ALOGD("sendUibcEvent: type=0x%X", type);
+
+    switch (type) {
+    case 0x30:
+    case 0x31:
+    case 0x32:
+        mSink->sendUIBCGenericTouchEvent(pEventDes);
+    break;
+    case 0x33:
+    case 0x34:
+        mSink->sendUIBCGenericKeyEvent(pEventDes);
+    break;
+    default:
+        return BAD_VALUE;
+    }
+    return OK;
+}
+
+
+static jint android_p2p_sendUibcEvent(JNIEnv *env, jobject *thiz, jstring eventDesc) {
+   UNUSED(thiz);
+   //ALOGD("[%s][%d]\n", __FUNCTION__,__LINE__);
+   const char *eventDescStr = env->GetStringUTFChars(eventDesc, NULL);
+   if (eventDescStr == NULL) {  // Out of memory
+        return -1;
+   }
+   //ALOGD("[%s][%d]eventDescStr[%s]\n", __FUNCTION__,__LINE__,eventDescStr);
+   return sendUibcEvent(eventDescStr);
+}
+
 static const JNINativeMethod gMethods[] = {

 public class WifiDisplayActivity extends Activity implements PeerListListener, PersistentGroupInfoListener, GroupInfoListener {
 
     private static final String TAG = "WifiDisplayActivity";
@@ -79,6 +80,10 @@ public class WifiDisplayActivity extends Activity implements PeerListListener, P
     private static final String SAVE_DIALOG_PEER = "PEER_STATE";
     private static final String SAVE_DEVICE_NAME = "DEV_NAME";
 
+    final static int GENERIC_INPUT_TYPE_ID_TOUCH_DOWN = 0;
+    final static int GENERIC_INPUT_TYPE_ID_TOUCH_UP = 1;
+    final static int GENERIC_INPUT_TYPE_ID_TOUCH_MOVE = 2;
+
     private WifiP2pDevice mThisDevice;
     private WifiP2pDeviceList mPeers = new WifiP2pDeviceList();
 
@@ -629,4 +634,73 @@ stopService(intent);
 		}
 	};
 
+    @Override
+    public boolean dispatchKeyEvent(KeyEvent event) {
+        Log.d(TAG,"dispatchKeyEvent getKeyCode=" + event.getKeyCode() + " event.getAction()=" + event.getAction());
+        return super.dispatchKeyEvent(event);
+    }
+
+    @Override
+    public boolean onKeyDown(int keyCode, KeyEvent event) {
+        Log.d(TAG,"onKeyDown keyCode=" + keyCode);
+        return super.onKeyDown(keyCode, event);
+    }
+
+    private String getTouchEventDesc(MotionEvent ev) {
+        final int pointerCount = ev.getPointerCount();
+        StringBuilder eventDesc = new StringBuilder();
+        eventDesc.append(String.valueOf(pointerCount)).append(",");
+        for (int p = 0; p < pointerCount; p++) {
+            eventDesc.append(String.valueOf(ev.getPointerId(p)))
+                    .append(",").append(
+                            String.valueOf((int) (ev.getXPrecision() * ev
+                                    .getX(p)))).append(",").append(
+                            String.valueOf((int) (ev.getYPrecision() * ev
+                                    .getY(p)))).append(",");
+        }
+        return eventDesc.toString();
+    }
+
+    @Override
+    public boolean onTouchEvent(MotionEvent event) {
+        final int action = event.getAction();
+        Log.d(TAG, "onTouchEvent action=" + action);
+        if(WifiDisplayService.isWifiDisplayConnect()){
+            switch (action & MotionEvent.ACTION_MASK) {
+                case MotionEvent.ACTION_DOWN: {
+                    StringBuilder eventDesc = new StringBuilder();
+                    eventDesc.append(
+                            String.valueOf(GENERIC_INPUT_TYPE_ID_TOUCH_DOWN))
+                            .append(",");
+
+                    eventDesc.append(getTouchEventDesc(event));
+                    WifiDisplayService.sendUibcInputEvent(eventDesc.toString());
+                    break;
+                }
+                case MotionEvent.ACTION_UP: {
+                    StringBuilder eventDesc = new StringBuilder();
+                    eventDesc.append(
+                            String.valueOf(GENERIC_INPUT_TYPE_ID_TOUCH_UP))
+                            .append(",");
+
+                    eventDesc.append(getTouchEventDesc(event));
+                    WifiDisplayService.sendUibcInputEvent(eventDesc.toString());
+                    break;
+                }
+                case MotionEvent.ACTION_MOVE: {
+                    StringBuilder eventDesc = new StringBuilder();
+                    eventDesc.append(
+                            String.valueOf(GENERIC_INPUT_TYPE_ID_TOUCH_MOVE))
+                            .append(",");
+
+                    eventDesc.append(getTouchEventDesc(event));
+                    WifiDisplayService.sendUibcInputEvent(eventDesc.toString());
+                    break;
+                }
+            }
+            return true;
+        }
+        return super.onTouchEvent(event);
+    }
+
 }

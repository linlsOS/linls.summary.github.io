+
+    private void updateRadioButton(int position, boolean bvalue){
+        int outputMode =  AudioManagerInterface.getARCMode();
+        boolean bpcm = false, braw = false, blgacy =  false , bauto = false;
+        boolean bvpcm = false, bvraw = false, bvlgacy =  false , bvauto = false;
+
+        switch (outputMode){
+            case AudioManagerInterface.ARC_PCM:
+                bpcm = true;
+                break;
+            case AudioManagerInterface.ARC_RAW:
+                braw = true;
+                break;
+            case AudioManagerInterface.ARC_LEGACY:
+                blgacy = true;
+                break;
+            case AudioManagerInterface.ARC_AUTO:
+                bauto = true;
+                break;
+        }
+
+        switch (position){
+            case AudioManagerInterface.ARC_PCM:
+                bvpcm = bvalue;
+                bvraw = bvlgacy = bvauto = !bvpcm;
+                break;
+            case AudioManagerInterface.ARC_RAW:
+                bvraw = bvalue;
+                bvpcm = bvlgacy = bvauto = !bvraw;
+                break;
+            case AudioManagerInterface.ARC_LEGACY:
+                bvlgacy = bvalue;
+                bvpcm = bvraw = bvauto = !bvlgacy;
+                break;
+            case AudioManagerInterface.ARC_AUTO:
+                bvauto = bvalue;
+                bvpcm = bvraw = bvlgacy = !bvauto;
+                break;
+        }
+
+        mVoiceArcPcm.setRadioButtonChecked(bvpcm, bpcm);
+        mVoiceArcRaw.setRadioButtonChecked(bvraw, braw);
+        mVoiceArcLegacy.setRadioButtonChecked(bvlgacy, blgacy);
+        mVoiceArcAuto.setRadioButtonChecked(bvauto, bauto);
+
     }
 
